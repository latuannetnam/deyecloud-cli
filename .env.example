# Deye Cloud API Credentials
# Copy this file to ~/.deye/.env and fill in your values
# Get App ID and Secret from https://developer.deyecloud.com

# API Base URL (choose your region)
# EU:  https://eu1-developer.deyecloud.com/v1.0
# US:  https://us1-developer.deyecloud.com/v1.0
# CN:  https://api.deye.com.cn/v1
DEYE_BASE_URL=https://eu1-developer.deyecloud.com/v1.0

# Developer credentials
DEYE_APP_ID=your_app_id_here
DEYE_APP_SECRET=your_app_secret_here

# Account credentials
DEYE_EMAIL=your_email_here
DEYE_PASSWORD=your_password_here
DEYE_COMPANY_ID=0

# ── Auto-managed (do not edit below this line) ──
# DEYE_TOKEN=
# DEYE_TOKEN_EXPIRES_AT=
# DEYE_DEVICE_SN=
